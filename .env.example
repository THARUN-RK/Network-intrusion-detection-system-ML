# Local Environment Configuration Template for NIDS Threat Intelligence
# Copy this file to .env for local development. Never commit .env to Git.
# On Render, set these variables in Dashboard -> Service -> Environment.

# VirusTotal API v3 Key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# AbuseIPDB API v2 Key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# Optional Cache TTL in seconds (default: 86400 = 24 hours)
THREAT_INTEL_CACHE_TTL=86400
