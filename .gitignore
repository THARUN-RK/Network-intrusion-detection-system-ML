# Virtual Environment
venv/
.venv/
env/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Raw and Processed Datasets (keep sample templates, ignore large CSVs)
dataset/raw/*.csv
dataset/processed/*.csv
!dataset/raw/.gitkeep
!dataset/processed/.gitkeep
!data/*.csv
!data/.gitkeep

# Machine Learning Trained Artifacts (track compressed svm_model.pkl, ignore huge external weights)
models/*.joblib
!models/svm_model.pkl
!models/model_metadata.json
!models/.gitkeep

# Generated Reports and Images (track evaluation reports for portfolio & deployment)
!reports/*.png
!reports/*.json
!reports/*.txt
!reports/.gitkeep

# Databases & Logs
*.db
*.sqlite
*.sqlite3
logs/*.log
logs/*.db
!logs/.gitkeep

# Environment & IDE
.env
.vscode/
.idea/
*.swp
*.swo

# OS Generated
.DS_Store
Thumbs.db

.streamlit/
